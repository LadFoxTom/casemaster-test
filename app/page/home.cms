// Mini-CRM dashboard. Counts each table and shows the latest 5 rows for
// each, demonstrating both `sql.fetch` (raw aggregate) and
// `iterator.ofEntity` (BO-aware list) against the same Neon database.
function home()

    set('contactCount', 0)
    iterate sql.fetch('SELECT count(*)::int AS n FROM crm_contact')
        set('contactCount', bo.attr([r], 'n'))
    end-iterate

    set('taskCount', 0)
    iterate sql.fetch('SELECT count(*)::int AS n FROM crm_task')
        set('taskCount', bo.attr([r], 'n'))
    end-iterate

    set('contactRows', '')
    iterate iterator.ofEntity(
        entities: < <@iterator/entity name: 'c', entity: 'crm/contact', orderBy: '-id'> >,
        rows: 5
    )
        set('contactRows', concat([contactRows],
            '<tr>',
                '<td class="col-id">', formatString('{0}', bo.attr([c], 'id')), '</td>',
                '<td><strong>', bo.attr([c], 'full_name'), '</strong></td>',
                '<td>', bo.attr([c], 'email'), '</td>',
                '<td>', bo.attr([c], 'company'), '</td>',
                '<td><a href="/maintenance/crm/contact/edit?id=',
                    formatString('{0}', bo.attr([c], 'id')), '">edit</a></td>',
            '</tr>'
        ))
    end-iterate

    // Tasks: format due_date as YYYY-MM-DD by stripping the JSON-quoted
    // ISO string that formatString emits for Date values.
    set('taskRows', '')
    iterate iterator.ofEntity(
        entities: < <@iterator/entity name: 't', entity: 'crm/task', orderBy: '-id'> >,
        rows: 5
    )
        set('dueRaw',  formatString('{0}', bo.attr([t], 'due_date')))
        set('dueText', if(eq([dueRaw], ''), '', substring([dueRaw], 1, 10)))
        set('status',  bo.attr([t], 'status'))
        set('pillCls', if(eq([status], 'done'), 'pill', 'pill warn'))
        set('taskRows', concat([taskRows],
            '<tr>',
                '<td class="col-id">', formatString('{0}', bo.attr([t], 'id')), '</td>',
                '<td><strong>', bo.attr([t], 'title'), '</strong></td>',
                '<td><span class="', [pillCls], '">', [status], '</span></td>',
                '<td>', [dueText], '</td>',
                '<td>contact #', formatString('{0}', bo.attr([t], 'contact_id')), '</td>',
                '<td><a href="/maintenance/crm/task/edit?id=',
                    formatString('{0}', bo.attr([t], 'id')), '">edit</a></td>',
            '</tr>'
        ))
    end-iterate

    response.clearContent()
    response.setContentType('text/html')
    response.write(script.call('./pageHeader', 'home', 'Dashboard'))
    response.write(concat(
        '<h1>Dashboard</h1>',
        '<p class="lead">Counts and the latest 5 rows from each table, ',
        'pulled live from the Neon database.</p>',

        '<div class="cards">',
            '<div class="card">',
                '<h3>Contacts</h3>',
                '<div class="n">', formatString('{0}', [contactCount]), '</div>',
                '<a href="/maintenance/crm/contact">Manage &rarr;</a>',
            '</div>',
            '<div class="card">',
                '<h3>Tasks</h3>',
                '<div class="n">', formatString('{0}', [taskCount]), '</div>',
                '<a href="/maintenance/crm/task">Manage &rarr;</a>',
            '</div>',
        '</div>',

        '<h2>Latest contacts</h2>',
        '<table class="t"><thead><tr>',
            '<th>id</th><th>name</th><th>email</th><th>company</th><th></th>',
        '</tr></thead><tbody>', [contactRows], '</tbody></table>',

        '<h2>Latest tasks</h2>',
        '<table class="t"><thead><tr>',
            '<th>id</th><th>title</th><th>status</th><th>due</th><th>contact</th><th></th>',
        '</tr></thead><tbody>', [taskRows], '</tbody></table>'
    ))
    response.write(script.call('./pageFooter'))
    response.flush()
    response.end()

end-function
