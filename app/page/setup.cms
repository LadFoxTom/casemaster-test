// One-shot bootstrap. Hit /page/foo/f/setup once to create the demo schema
// in the connected Postgres (Neon). Idempotent — CREATE TABLE IF NOT EXISTS
// for both tables, plus a guarded INSERT that only seeds when crm_contact
// is empty. Safe to call repeatedly.
function setup()

    sql.execute(concat(
        'CREATE TABLE IF NOT EXISTS crm_contact (',
            'id          BIGSERIAL    PRIMARY KEY, ',
            'full_name   VARCHAR(120) NOT NULL, ',
            'email       VARCHAR(200), ',
            'company     VARCHAR(120), ',
            'created_at  TIMESTAMPTZ  NOT NULL DEFAULT now()',
        ')'
    ))

    sql.execute(concat(
        'CREATE TABLE IF NOT EXISTS crm_task (',
            'id          BIGSERIAL    PRIMARY KEY, ',
            'contact_id  BIGINT       REFERENCES crm_contact(id) ON DELETE SET NULL, ',
            'title       VARCHAR(200) NOT NULL, ',
            'status      VARCHAR(20)  NOT NULL DEFAULT ', "'open'", ', ',
            'due_date    DATE, ',
            'created_at  TIMESTAMPTZ  NOT NULL DEFAULT now()',
        ')'
    ))

    set('seeded', 0)
    iterate sql.fetch('SELECT count(*)::int AS n FROM crm_contact')
        if eq(bo.attr([r], 'n'), 0)
            sql.execute(concat(
                'INSERT INTO crm_contact (full_name, email, company) VALUES ',
                "('Ada Lovelace',  'ada@analytical.example',  'Analytical Engine Co.'), ",
                "('Grace Hopper',  'grace@navy.example',      'US Navy'), ",
                "('Linus Torvalds','linus@kernel.example',    'Linux Foundation')"
            ))
            sql.execute(concat(
                'INSERT INTO crm_task (contact_id, title, status, due_date) VALUES ',
                "(1, 'Send welcome email',    'done', '2026-05-01'), ",
                "(1, 'Schedule demo call',    'open', '2026-05-15'), ",
                "(2, 'Review compiler notes', 'open', '2026-05-20'), ",
                "(3, 'Discuss kernel patch',  'open', '2026-06-01'), ",
                "(3, 'Follow up next week',   'open', '2026-05-12')"
            ))
            set('seeded', 1)
        end-if
    end-iterate

    response.clearContent()
    response.setContentType('text/html')
    response.write(script.call('./pageHeader', 'setup', 'Setup'))
    response.write(concat(
        '<h1>Setup</h1>',
        '<p class="lead">Create the demo schema and seed sample rows. ',
        'Idempotent &mdash; safe to run again at any time.</p>',

        '<div class="banner ok">',
            '&#10003; Tables ensured: <code>crm_contact</code>, <code>crm_task</code>',
        '</div>',

        '<div class="banner ',
            if(eq([seeded], 1), 'ok', 'warn'),
        '">',
            if(eq([seeded], 1),
                '&#10003; Seeded 3 contacts and 5 tasks.',
                'Tables already populated &mdash; seed step skipped.'
            ),
        '</div>',

        '<h2>Next</h2>',
        '<p>',
            '<a class="btn" href="/page/foo/f/home">Open the dashboard &rarr;</a> ',
            '<a class="btn secondary" href="/maintenance/crm/contact">Manage contacts</a> ',
            '<a class="btn secondary" href="/maintenance/crm/task">Manage tasks</a>',
        '</p>'
    ))
    response.write(script.call('./pageFooter'))
    response.flush()
    response.end()

end-function
